{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WordCraft: Debug desktop",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--locked",
                    "--package",
                    "wordcraft",
                    "--bin",
                    "wordcraft",
                    "--config",
                    "profile.dev.debug=2",
                    "--config",
                    "profile.dev.opt-level=0"
                ],
                "filter": {
                    "name": "wordcraft",
                    "kind": "bin"
                }
            },
            "args": ["--sample"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_BACKTRACE": "1"
            },
            "sourceLanguages": ["rust"]
        }
    ]
}
